# Environment the backend is running on. Must be strictly prod in production environment
ENV=dev

# DB Setup
MONGODB_HOST=

# Authentication
AUTH_SECRET=
ACCESS_TOKEN_EXPIRY_TIME=30
ALGORITHM=HS256

# Name of folder where images live
UPLOAD_FOLDER=static/uploads

# Cleaning
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp
CHUNK_SIZE=1048576
MAX_FILE_SIZE = 10485760